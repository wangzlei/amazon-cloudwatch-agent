{
  "family": "cwagent-daemon",
  "requiresCompatibilities": ["EC2"],
  "networkMode": "host",
  "taskRoleArn": "<CWAGENT_TASK_ROLE_ARN>",
  "executionRoleArn": "<TASK_EXECUTION_ROLE_ARN>",
  "containerDefinitions": [
    {
      "name": "cloudwatch-agent",
      "image": "public.ecr.aws/cloudwatch-agent/cloudwatch-agent:<OFFICIAL_VERSION>",
      "essential": true,
      "memoryReservation": 128,
      "memory": 512,
      "environment": [
        {"name": "CW_CONFIG_CONTENT", "value": "<cwagent-config.json, as one line>"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "<LOG_GROUP>",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "cwagent"
        }
      }
    }
  ]
}
