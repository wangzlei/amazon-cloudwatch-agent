{
  "family": "cloudwatch-agent-ebpf",
  "requiresCompatibilities": [
    "EC2"
  ],
  "networkMode": "host",
  "pidMode": "host",
  "taskRoleArn": "<TASK_ROLE_ARN>",
  "executionRoleArn": "<TASK_EXECUTION_ROLE_ARN>",
  "containerDefinitions": [
    {
      "name": "cloudwatch-agent",
      "image": "<IMAGE>",
      "essential": true,
      "privileged": true,
      "stopTimeout": 30,
      "memoryReservation": 256,
      "memory": 1024,
      "environment": [
        {
          "name": "CW_CONFIG_CONTENT",
          "value": "{\"agent\":{\"region\":\"<REGION>\"}}"
        },
        {
          "name": "CW_OTEL_CONFIG_CONTENT",
          "value": "<packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml, as one string>"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "bpffs",
          "containerPath": "/sys/fs/bpf"
        },
        {
          "sourceVolume": "tracefs",
          "containerPath": "/sys/kernel/tracing"
        },
        {
          "sourceVolume": "debugfs",
          "containerPath": "/sys/kernel/debug"
        },
        {
          "sourceVolume": "cgroup",
          "containerPath": "/sys/fs/cgroup"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "<LOG_GROUP>",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "cwagent"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "bpffs",
      "host": {
        "sourcePath": "/sys/fs/bpf"
      }
    },
    {
      "name": "tracefs",
      "host": {
        "sourcePath": "/sys/kernel/tracing"
      }
    },
    {
      "name": "debugfs",
      "host": {
        "sourcePath": "/sys/kernel/debug"
      }
    },
    {
      "name": "cgroup",
      "host": {
        "sourcePath": "/sys/fs/cgroup"
      }
    }
  ]
}
