{
  "agent": {
    "config": {
      "agent": {
        "region": "<REGION>"
      },
      "logs": {
        "metrics_collected": {
          "application_signals": {},
          "kubernetes": {
            "enhanced_container_insights": true
          }
        }
      },
      "traces": {
        "traces_collected": {
          "application_signals": {}
        }
      },
      "opentelemetry": {
        "cluster_name": "<CLUSTER_NAME>",
        "collect": {
          "otlp": {
            "grpc_endpoint": "127.0.0.1:4327",
            "http_endpoint": "127.0.0.1:4328"
          }
        }
      }
    }
  }
}
